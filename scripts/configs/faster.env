# Faster-YOCO: environment switches of the measured configuration (round 25, commit 026c4ea, full check 2.1247x).
# Every YOCO_* switch is off unless set; with none set the code takes the upstream path.
# Values match .harness/config.json and optimizations/fused_adam_qkvg.json.
# Measured only with the recipe of scripts/train_faster_yoco_3b.sh: 8 ranks, --zero-sharding os, --bf16, 1 x 2048 tokens.
# Usage: source scripts/configs/faster.env
export YOCO_ZERO1_FAST=1          # ZeRO-1: fp32 gradient copy/scale and Adam only for the owned shard; bf16 exchange
export YOCO_LAYER_GRAPHS=1        # CUDA graphs of the 26 decoder layers, forward and backward
export YOCO_ZERO1_ALLGATHER=1     # one in-place all-gather of the updated bf16 parameters instead of 8 broadcasts
export YOCO_ZERO1_PARAM_VIEWS=1   # the bf16 parameters live in the all-gather buffer (needs YOCO_ZERO1_ALLGATHER)
export YOCO_COMPILE_NORM=1        # RMSNorm compiled with Inductor; superseded by YOCO_TRITON_NORM (kept as measured)
export YOCO_PARAM_ALLREDUCE=1     # per-parameter gradient reduction as soon as each gradient is ready (not DDP buckets)
export YOCO_TRAINER_NOSYNC=1      # fairseq train_step and end-of-update logging without per-update host syncs
export YOCO_GRAD_REDUCE_OWNER=1   # reduce each gradient only to the rank owning its optimizer state (needs the two above)
export YOCO_TRITON_NORM=1         # Triton RMSNorm forward/backward, fp32 statistics, no atomics
export YOCO_OWNER_EMBED_GRAD=1    # token-embedding gradient formed on its owner from all ranks' token rows
export YOCO_SUBLN_FUSED=1         # per-head subln fused with the head -> token transpose
export YOCO_Z1_ONE_PASS=1         # owned fp32 gradients = float(g16) * factor in one pass; one foreach cast
export YOCO_FUSED_CE=1            # Triton cross-entropy on the bf16 logits (fp32 math)
export YOCO_COMPILE_GR=1          # gate-retention elementwise work compiled with Inductor around the Triton recurrence
export YOCO_CE_REDUCE=1           # gradient reduction through the GPU copy engines, fp32 rank-order sum on the owner
export YOCO_FUSED_ADAM=1          # Triton Adam that also writes the bf16 copy of each updated master weight
export YOCO_Z1_SCALE_KERNEL=1     # vectorized Triton kernel for the one-pass gradient scaling
export YOCO_FUSE_QKVG=1           # q/k/v/g projections as one GEMM against the concatenated weights
